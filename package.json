{
  "dependencies": {
    "@ant-design/cssinjs": "^1.23.0",
    "@tosspayments/tosspayments-sdk": "^2.4.0",
    "antd": "^5.25.1",
    "axios": "^1.9.0",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-masonry-css": "^1.0.16",
    "yet-another-react-lightbox": "^3.25.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:layers": "node scripts/check-layers.cjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run check:layers && npm run typecheck && npm test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install chromium",
    "check:docs": "python3 scripts/check-docs.py",
    "docs:contracts": "python3 scripts/check-docs.py --contracts",
    "docs:record": "python3 scripts/check-docs.py --record",
    "docs:prove": "python3 scripts/check-docs.py --prove",
    "test:docs": "python3 scripts/check-docs.py --self-test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.3.3"
  }
}
