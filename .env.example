NEXT_PUBLIC_API_URL=https://api.crefans.com
NEXT_PUBLIC_APP_URL=https://www.crefans.com
NEXT_PUBLIC_APP_ENV=prod
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_

# Landing: true = bundled preview assets, false = database creator data (build-time).
NEXT_PUBLIC_LANDING_USE_ASSETS=true

# Kakao Talk Share: public JavaScript key, not REST API/Admin key.
# Register the site in Kakao JavaScript SDK domains AND Product Link web domains.
# Build-time: restart dev/rebuild deployment after setting; empty disables Kakao sharing.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
